    {
      "name": "5. The Codex (/codex)",
      "item": [
        {
          "name": "List Codex Entries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/codex"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Codex Entry (Points Threshold Enforced)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/codex",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Debugging race condition in event loop\",\n  \"category\": \"Debugging\",\n  \"problem\": \"Asynchronous state updates were mutating shared cache simultaneously.\",\n  \"tried\": \"Adding mutex locks inside individual event listeners.\",\n  \"fix\": \"Moved state mutations to a single deterministic reduction pipeline.\",\n  \"lesson\": \"Single source of truth prevents distributed concurrency race conditions.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created or 403 Forbidden (based on points)', function () { pm.expect([201, 403]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
