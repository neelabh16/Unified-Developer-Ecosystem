# =============================================================================
# DevVerse Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Create a database user (Database Access → Add New Database User)
# 3. Whitelist your IP (Network Access → Add IP Address → Add Current IP or 0.0.0.0/0 for dev)
# 4. Get connection string (Connect → Drivers → Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devverse?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# Frontend Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5500

# Cookie Settings
COOKIE_SECURE=false
