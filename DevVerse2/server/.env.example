# =============================================================================
# DevVerse Backend Environment Configuration Template
# =============================================================================

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS and CSRF origin validation)
CLIENT_ORIGIN=http://localhost:5500

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://neelabh1626_db_user:s0JvN3an3pwMwr1m@cluster0.sdrhnad.mongodb.net/devverse?retryWrites=true&w=majority

# JWT Authentication Secret (min 32 characters for security)
JWT_SECRET=super_secret_jwt_key_with_at_least_32_characters_123456

# JWT Token Expiry (e.g., 7d, 24h)
JWT_EXPIRES_IN=90d

# JWT Cookie Expiry in Days
JWT_COOKIE_EXPIRES_IN=90

# Real GitHub OAuth 2.0 Credentials
# Register app at: https://github.com/settings/developers -> OAuth Apps
# Homepage URL: http://localhost:5500
# Authorization callback URL: http://localhost:5000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Real Google OAuth 2.0 Credentials
# Register app at: https://console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
